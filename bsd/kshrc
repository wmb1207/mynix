# Only interactive shells
[[ $- != *i* ]] && return

# === History ===
HISTFILE="$HOME/.ksh_history"
HISTSIZE=10000

_c1=$(printf '\033[38;5;67m')
_cr=$(printf '\033[0m')
PS1='${_c1}$(pwd | sed "s|$HOME|~|")${_cr} $ '

# === Aliases ===
alias ll='ls -lhG'
alias la='ls -lahG'
alias gs='git status'
alias gc='git commit'
alias ga='git add'
alias gl='git log --oneline --graph --decorate'
alias em='emacsclient -nw'
alias e='emacsclient -c -a emacs'

# === Key bindings ===
bind '^[[1;5C'=em-next-word       # Ctrl+Right
bind '^[[1;5D'=ed-prev-word       # Ctrl+Left
bind '^[[5~'=ed-search-prev-history  # PgUp
bind '^[[6~'=ed-search-next-history  # PgDn
bind '^[[H'=ed-move-to-beg        # Home
bind '^[[F'=ed-move-to-end        # End
bind '^R'=ed-search-prev-history

# === fzf ===
if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/*"'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
fi

export EDITOR='emacsclient -c -a emacs'
export VISUAL="$EDITOR"
export PAGER='less -R'
export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$PATH"
export ENV="$HOME/.kshrc"

# === Direnv ===
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook ksh)"
fi

# === Starship ===
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init ksh)"
fi

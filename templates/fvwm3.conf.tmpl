InfoStoreAdd terminal urxvtc

# Run command (Meta+Space / Super+Space)
# InfoStoreAdd runcmd "dmenu.sh"

# InfoStoreAdd runcmdopt ""

InfoStoreAdd runcmd "bash"

InfoStoreAdd runcmdopt "dmenu.sh"


DesktopConfiguration global

###########
# 1: Functions
###########

DestroyFunc StartFunction
AddToFunc   StartFunction
+ I Test (Init) InitBackground

# --- Left panel (window list + pager + xclock + xload) ---
+ I Module FvwmButtons LeftPanel
+ I Module FvwmMFL

+ I Module FvwmEvent EventNewDesk
+ I Test (Init) Exec exec dunst --config ~/.config/dunst/dunstrc &

+ I Test (Init) Exec exec xsetroot -cursor_name left_ptr
+ I Test (Init) Exec exec battery --daemon &
+ I Test (Init) Exec exec datetime --daemon &
+ I Test (Init) Exec exec screen_setup --daemon &
+ I Test (Init) Exec exec sh -c 'systemctl --user import-environment DISPLAY XAUTHORITY PATH XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS 2>/dev/null; emacs --daemon --eval "(progn (select-frame (make-frame-on-display \":0\")) (make-frame-invisible))"; until emacsclient -e t 2>/dev/null; do sleep 0.5; done; emacsclient -c > /dev/null' &
+ I Test (Init) Exec exec xrdb -merge ~/.Xresources &
+ I Test (Init) Exec exec clipmenud &
+ I Test (Init) Exec exec libinput-gestures &
+ I Test (Init) Exec exec kbd --sync &
+ I Test (Init) Exec exec xsetroot -solid "{{background}}" &
+ I Test (Init) Exec exec urxvtd -q -o -f &

DestroyFunc RaiseMoveX
AddToFunc RaiseMoveX
+ I Raise
+ M $0
+ D $1

DestroyFunc RaiseMove
AddToFunc RaiseMove
+ I Raise
+ M $0

DestroyFunc MoveToCurrent
AddToFunc MoveToCurrent
+ I ThisWindow MoveToPage
+ I ThisWindow MoveToDesk

DestroyFunc ViewManPage
AddToFunc   ViewManPage
+ I Exec exec $[infostore.terminal] -g 80x40 \
  -n "Manual Page - $0" -T "Manual Page - $0" -e man "$0"

DestroyFunc SetBG
AddToFunc   SetBG
+ I Test (f $[FVWM_USERDIR]/images/background/$0) \
    Exec exec fvwm-root $[FVWM_USERDIR]/images/background/$0
+ I TestRc (Match) Exec exec ln -fs images/background/$0 \
    $[FVWM_USERDIR]/.BGdefault
+ I TestRc (Match) Break
+ I Test (!f $[FVWM_DATADIR]/default-config/images/background/$0) Break
+ I Exec exec fvwm-root $[FVWM_DATADIR]/default-config/images/background/$0
+ I Exec exec ln -fs $[FVWM_DATADIR]/default-config/images/background/$0 \
    $[FVWM_USERDIR]/.BGdefault

DestroyFunc IconManClick
AddToFunc   IconManClick
+ I ThisWindow (Raised, !Shaded, !Iconic, CurrentPage, AnyScreen) Iconify
+ I TestRc (Match) Break
+ I ThisWindow WindowShade off
+ I ThisWindow Iconify off
+ I ThisWindow Raise
+ I ThisWindow (AcceptsFocus) FlipFocus

DestroyFunc ToggleTitle
AddToFunc   ToggleTitle
+ I ThisWindow (HasTitle) WindowStyle !Title
+ I TestRc (NoMatch) WindowStyle Title

DestroyFunc ChangeDesk
AddToFunc   ChangeDesk
+ I SendToModule FvwmButtons ChangeButton desk0 Colorset 10
+ I SendToModule FvwmButtons ChangeButton desk1 Colorset 10
+ I SendToModule FvwmButtons ChangeButton desk2 Colorset 10
+ I SendToModule FvwmButtons ChangeButton desk3 Colorset 10
+ I SendToModule FvwmButtons ChangeButton desk$0 Colorset 11


#############
# 2: Styles #
#############

DesktopName 0 Main
DesktopName 1 Desk1
DesktopName 2 Desk2
DesktopName 3 Desk3
DesktopName 4 Desk4

DesktopSize 2x2
EdgeResistance 0
EdgeScroll 0 0
EdgeThickness 1
Style * EdgeMoveDelay 350, EdgeMoveResistance 350

Style * Title

# No reserved "panel" space (tool stack floats)
EwmhBaseStruts 151 0 0 0
#EwmhBaseStruts 172 15 26 15

ClickTime 250
MoveThreshold 3

Style * SloppyFocus, MouseFocusClickRaises

DefaultFont "xft:{{font}}:Bold:size=10:antialias=True"

Style * MinOverlapPlacement, GrabFocusOff, !UsePPosition

Style * !MoveOpaque
Style * !ResizeOpaque, SnapAttraction 15 SameType ScreenAll, SnapGrid

Style * DecorateTransient, StackTransientParent
Style * !FPGrabFocusTransient, FPReleaseFocusTransient

Style * WindowShadeScrolls, WindowShadeSteps 10

IgnoreModifiers L25

Style * Colorset 1, HilightColorset 2
Style * BorderColorset 3
Style * HilightBorderColorset 3
Style * BorderWidth 1, HandleWidth 0, !FvwmBorder, !FirmBorder

# Disable icons from appearing on desktop.
Style * !Icon
Style * MiniIcon none
Style * !Handles

# Window Specific Styles
Style "Emacs" StartsMaximized
Style URxvt ResizeHintOverride
Style ConfirmQuit !Title, PositionPlacement Center, WindowListSkip, Layer 6
Style FvwmIdent WindowListSkip

# Sticky tool windows (Plan 9-ish stack)
Style LeftPanel   !Title, Borders, BorderWidth 1, !FvwmBorder, !Handles, Sticky, WindowListSkip, NeverFocus, Layer 6, PositionPlacement
# Style xclock      !Title, !Borders, !Handles, Sticky, WindowListSkip, NeverFocus, Layer 6
# Style xload       !Title, !Borders, !Handles, Sticky, WindowListSkip, NeverFocus, Layer 6

###########
# 3: Colorsets - {{name}}
###########

Colorset 0  fg {{foreground}}, bg {{background}}, hi {{bgAlt}}, sh {{bgAlt}}, Plain, NoShape
Colorset 1  fg {{foreground}}, bg {{background}}, hi {{bgAlt}}, sh {{bgAlt}}, Plain, NoShape
Colorset 2  fg {{background}}, bg {{active}},     hi {{activeAlt}}, sh {{activeAlt}}, Plain, NoShape
Colorset 3  fg {{activeAlt}}, bg {{activeAlt}}, hi {{activeAlt}}, sh {{activeAlt}}, Plain, NoShape
Colorset 4  fg {{active}},     bg {{active}},     hi {{active}},     sh {{active}},     Plain, NoShape

Colorset 5  fg {{foreground}}, bg {{background}}, hi {{bgAlt}},     sh {{bgAlt}},     Plain, NoShape
Colorset 6  fg {{background}}, bg {{active}},     hi {{activeAlt}}, sh {{activeAlt}}, Plain, NoShape
Colorset 7  fg {{comments}},   bg {{background}}, hi {{bgAlt}},     sh {{bgAlt}},     Plain, NoShape
Colorset 8  fg {{background}}, bg {{activeAlt}}, hi {{active}},     sh {{active}},     Plain, NoShape

Colorset 10 fg {{foreground}}, bg {{background}}, hi {{bgAlt}},     sh {{bgAlt}},     Plain, NoShape
Colorset 11 fg {{background}}, bg {{active}},     hi {{activeAlt}}, sh {{activeAlt}}, Plain, NoShape
Colorset 12 fg {{background}}, bg {{olive}},      hi {{olive}},      sh {{olive}},      Plain, NoShape
Colorset 13 fg {{background}}, bg {{activeAlt}}, hi {{active}},     sh {{active}},     Plain, NoShape
Colorset 14 fg {{comments}},   bg {{bgAlt}},     hi {{selection}},  sh {{selection}},  Plain, NoShape


#######
# 4: Menus
###########

MenuStyle * MenuColorset 5, ActiveColorset 6, GreyedColorset 7, TitleColorset 8
MenuStyle * Hilight3DOff, HilightBack, HilightTitleBack, SeparatorsLong
MenuStyle * TrianglesSolid, TrianglesUseFore
MenuStyle * ItemFormat "%s%|%3.1i%5.3l%5l%5r%5.3>%|"
MenuStyle * Font "xft:{{font}}:Bold:size=10:antialias=True"
MenuStyle * IconsOff


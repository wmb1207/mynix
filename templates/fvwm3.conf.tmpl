Test (!x stalonetray) PipeRead 'echo "*RightPanel: (120x$(($[monitor.$[monitor.primary].height]-205)),\
    Top, Swallow FvwmIconMan \'Module FvwmIconMan\', Frame 0)"'
*RightPanel: (120x45, Swallow(NoClose, UseOld) stalonetray \
               'Exec exec stalonetray', Frame 0)

*RightPanel: (120x45, Swallow DateTime 'Module FvwmScript FvwmScript-DateTime',\
    Frame 0)
*RightPanel: (120x5, Frame 0)

# --- LeftPanel (FvwmButtons wrapping window list, pager, xclock, xload) ---
DestroyModuleConfig LeftPanel:*
*LeftPanel: Geometry 150x$[monitor.$[monitor.primary].height]+0+0@p
*LeftPanel: Colorset 10
*LeftPanel: Rows $[monitor.$[monitor.primary].height]
*LeftPanel: Columns 150
*LeftPanel: Frame 0
*LeftPanel: Font "xft:{{font}}:Bold:size=10:antialias=True"
*LeftPanel: (150x24, Title "run", Action(Mouse 1) "Exec exec $[infostore.runcmd] $[infostore.runcmdopt]", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x1, Colorset 3, Frame 0)
*LeftPanel: (150x24, Title "browser",  Action(Mouse 1) "Exec exec librewolf",               Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x24, Title "editor",   Action(Mouse 1) "Exec exec emacsclient -c -a emacs > dev/null", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x24, Title "terminal", Action(Mouse 1) "Exec exec urxvtc",                  Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x24, Title "apps",     Action(Mouse 1) "WindowList Root c c NoIcons, AllDesks, TruncateLabel 76", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x1, Colorset 3, Frame 0)
PipeRead 'echo "*LeftPanel: (150x$(($[monitor.$[monitor.primary].height]-794)), Top, Swallow(UseOld,NoClose) FvwmIconMan '\''Module FvwmIconMan IconManDock'\'', Frame 0)"'
*LeftPanel: (150x1, Colorset 3, Frame 0)
*LeftPanel: (50x24,  Title "bt",   Action(Mouse 1) "Exec exec $[infostore.terminal] -title bluetoothctl -e bluetoothctl", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (50x24,  Title "vol",  Action(Mouse 1) "Exec exec $[infostore.terminal] -title pulsemixer -e pulsemixer",    Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (50x24,  Title "wifi", Action(Mouse 1) "Exec exec $[infostore.terminal] -title nmtui -e nmtui",              Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x24, Id kbdbtn, Title "kbd:dv", Action(Mouse 1) "Exec exec kbd",                                      Colorset 10, ActiveColorset 11, Frame 0)
PipeRead 'echo "*LeftPanel: (150x24, Title '\''help'\'', Action(Mouse 1) '\''Exec exec $[infostore.terminal] -title keys -geometry 100x$(($[monitor.$[monitor.primary].height]/18))+$(($[monitor.$[monitor.primary].width]/2-400))+0 -e keys'\'', Colorset 10, ActiveColorset 11, Frame 0)"'
*LeftPanel: (75x24,  Title "br-", Action(Mouse 1) "Exec exec backlight --decrease", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (75x24,  Title "br+", Action(Mouse 1) "Exec exec backlight --increase", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (75x24,  Title "dark",  Action(Mouse 1) "Exec exec theme dark",  Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (75x24,  Title "light", Action(Mouse 1) "Exec exec theme light", Colorset 14, ActiveColorset 13, Frame 0)
*LeftPanel: (150x24,  Title "lock", Action(Mouse 1) "Exec exec xsecurelock", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x24, Id datetimebtn, Title "--- -- --:--", Action(Mouse 1) "Exec exec datetime", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x24, Id battbtn, Title "bat:--", Action(Mouse 1) "Exec exec battery -n", Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (75x24, Title "reboot", Action(Mouse 1) 'Exec exec $[infostore.terminal] -title reboot -geometry 70x5+150+0 -e loksh -c "echo \'You are about to reboot your machine\' && echo && doas reboot"', Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (75x24, Title "poweroff", Action(Mouse 1) 'Exec exec $[infostore.terminal] -title poweroff -geometry 70x5+150+0 -e loksh -c "echo \'You are about to powerroff your machine\' && echo && doas poweroff"', Colorset 10, ActiveColorset 11, Frame 0)
*LeftPanel: (150x1, Colorset 3, Frame 0)

*LeftPanel: (150x150, Swallow(UseOld,NoClose) FvwmPager 'Module FvwmPager PagerDock', Frame 0)
# *LeftPanel: (150x150, Swallow(UseOld,NoClose) xload 'Exec exec xload -bg "#e0d8c7" -fg "#3a2018"', Frame 0)
# *LeftPanel: (150x150, Swallow(UseOld,NoClose) xclock 'Exec exec xclock -geometry 150x150 -bg "#e0d8c7" -fg "#3a2018"', Frame 0)

# --- IconManDock (swallowed into LeftPanel) ---
DestroyModuleConfig IconManDock:*
*IconManDock: ManagerGeometry 1x0
*IconManDock: ButtonGeometry 150x24
*IconManDock: Colorset 10
*IconManDock: FocusColorset 11
*IconManDock: SelectColorset 12
*IconManDock: DrawIcons never
*IconManDock: MiniIcons false
*IconManDock: ReliefThickness 0
*IconManDock: Format "%t"
*IconManDock: Font "xft:{{font}}:Bold:size=10:antialias=True"
*IconManDock: Action Mouse 1 A sendcommand IconManClick
*IconManDock: Action Mouse 3 A sendcommand "Menu MenuIconOps"
*IconManDock: Sort id
*IconManDock: Resolution global
*IconManDock: Tips needed

DestroyModuleConfig EventNewDesk:*
*EventNewDesk: PassID
*EventNewDesk: new_desk ChangeDesk

# Global no-icons policy (redundancy ok)
Style * IconOverride
MenuStyle * IconsOff

# Local configuration file hook
Test (f $[FVWM_USERDIR]/local.config) Read $[FVWM_USERDIR]/local.config

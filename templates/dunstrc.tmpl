[global]
    font = "{{font}} 10"
    background = "{{black}}"
    foreground = "{{green}}"
    frame_color = "{{frame}}"
    separator_color = "#101010"
    width = 600
    offset=0x0
    horizontal_padding = 0
    padding = 2
    frame_width = 1
    gap_size = 10
    origin = center-left
    alignment = center
    show_indicators = false

[urgency_low]
    background = "{{black}}"
    foreground = "{{green}}"
    frame_color = "{{frame}}"
    timeout = 10

[urgency_normal]
    background = "{{black}}"
    foreground = "{{white}}"
    frame_color = "{{green}}"
    timeout = 10

[urgency_critical]
    background = "{{black}}"
    foreground = "{{red}}"
    frame_color = "{{red}}"
    timeout = 0

[spotify]
    appname = "Spotify"
    background = "{{black}}"
    foreground = "{{green}}"
    frame_color = "{{green}}"
    timeout = 5
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    
# Alternative rule if Spotify uses different app names
[spotify_alt]
    desktop_entry = "spotify"
    background = "{{black}}"
    foreground = "{{green}}"
    frame_color = "{{green}}"
    timeout = 5
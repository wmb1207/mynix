[global]
    font = "DejaVu Sans Mono 10"
    background = "#252320"
    foreground = "#657050"
    frame_color = "#4a6a78"
    separator_color = "#101010"
    width = 150
    offset=0x0
    horizontal_padding = 0
    padding = 0
    frame_width = 2
    gap_size = 10
    origin = center-left
    alignment = center
    show_indicators = false

[urgency_low]
    background = "#252320"
    foreground = "#657050"
    frame_color = "#4a6a78"
    timeout = 10

[urgency_normal]
    background = "#252320"
    foreground = "#b5b2a0"
    frame_color = "#657050"
    timeout = 10

[urgency_critical]
    background = "#252320"
    foreground = "#884545"
    frame_color = "#884545"
    timeout = 0

[spotify]
    appname = "Spotify"
    background = "#252320"
    foreground = "#657050"
    frame_color = "#657050"
    timeout = 5
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    
# Alternative rule if Spotify uses different app names
[spotify_alt]
    desktop_entry = "spotify"
    background = "#252320"
    foreground = "#657050"
    frame_color = "#657050"
    timeout = 5
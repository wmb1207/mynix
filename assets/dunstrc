[global]
    font = "CozetteVector 14"
    background = "#121212"
    foreground = "#C8C8C8"
    frame_color = "#121212"
    separator_color = "#101010"
    offset=140x0
    horizontal_padding = 0
    padding = 0
    frame_width = 0
    gap_size = 10
    origin = top-right
    alignment = center

[urgency_low]
    background = "#121212"
    foreground = "#C8C8C8"
    frame_color = "#121212"
    timeout = 10

[urgency_normal]
    background = "#121212"
    foreground = "#C8C8C8"
    frame_color = "#C8C8C8"
    timeout = 10

[urgency_critical]
    background = "#121212"
    foreground = "#ff8059"
    frame_color = "#ff8059"
    timeout = 0

[spotify]
    appname = "Spotify"
    background = "#121212"
    foreground = "#C8C8C8"
    frame_color = "#C8C8C8"
    timeout = 5
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    
# Alternative rule if Spotify uses different app names
[spotify_alt]
    desktop_entry = "spotify"
    background = "#121212"
    foreground = "#C8C8C8"
    frame_color = "#C8C8C8"
    timeout = 5
[global]
    font = "DejaVu Sans Mono 10"
    background = "#41413f"
    foreground = "#609f60"
    frame_color = "#326c77"
    separator_color = "#101010"
    width = 150
    offset=0x0
    horizontal_padding = 0
    padding = 0
    frame_width = 2
    gap_size = 10
    origin = center-left
    alignment = center
    show_indicators = false

[urgency_low]
    background = "#41413f"
    foreground = "#609f60"
    frame_color = "#326c77"
    timeout = 10

[urgency_normal]
    background = "#41413f"
    foreground = "#ffffe9"
    frame_color = "#609f60"
    timeout = 10

[urgency_critical]
    background = "#41413f"
    foreground = "#cc3333"
    frame_color = "#cc3333"
    timeout = 0

[spotify]
    appname = "Spotify"
    background = "#41413f"
    foreground = "#609f60"
    frame_color = "#609f60"
    timeout = 5
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    
# Alternative rule if Spotify uses different app names
[spotify_alt]
    desktop_entry = "spotify"
    background = "#41413f"
    foreground = "#609f60"
    frame_color = "#609f60"
    timeout = 5
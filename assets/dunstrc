[global]
    font = "CozetteVector 14"
    background = "#99cccc"
    foreground = "#000000"
    frame_color = "#eaffff"
    separator_color = "#101010"
    offset=120x0
    horizontal_padding = 0
    padding = 0
    frame_width = 2
    gap_size = 10
    origin = top-right
    alignment = center

[urgency_low]
    background = "#99cccc"
    foreground = "#000000"
    frame_color = "#eaffff"
    timeout = 10

[urgency_normal]
    background = "#99cccc"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 10

[urgency_critical]
    background = "#99cccc"
    foreground = "#875f5f"
    frame_color = "#875f5f"
    timeout = 0

[spotify]
    appname = "Spotify"
    background = "#99cccc"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 5
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    
# Alternative rule if Spotify uses different app names
[spotify_alt]
    desktop_entry = "spotify"
    background = "#99cccc"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 5
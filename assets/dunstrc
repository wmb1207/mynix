[global]
    font = "DejaVu Sans Mono 10"
    background = "#44443C"
    foreground = "#9BA657"
    frame_color = "#CFB980"
    separator_color = "#101010"
    width = 600
    offset=0x0
    horizontal_padding = 0
    padding = 2
    frame_width = 1
    gap_size = 10
    origin = center-left
    alignment = center
    show_indicators = false

[urgency_low]
    background = "#44443C"
    foreground = "#9BA657"
    frame_color = "#CFB980"
    timeout = 10

[urgency_normal]
    background = "#44443C"
    foreground = "#BEBFB7"
    frame_color = "#9BA657"
    timeout = 10

[urgency_critical]
    background = "#44443C"
    foreground = "#A56F4B"
    frame_color = "#A56F4B"
    timeout = 0

[spotify]
    appname = "Spotify"
    background = "#44443C"
    foreground = "#9BA657"
    frame_color = "#9BA657"
    timeout = 5
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    
# Alternative rule if Spotify uses different app names
[spotify_alt]
    desktop_entry = "spotify"
    background = "#44443C"
    foreground = "#9BA657"
    frame_color = "#9BA657"
    timeout = 5
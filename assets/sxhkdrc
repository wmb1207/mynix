# launch terminal
super + Return
  ghostty

super + Escape
  pkill -USR1 -x sxhkd

super + alt + e
      emacs

super + space
      dmenu_run -fn "DejaVu Sans Mono" -nb "#000000" -nf "#e6e6e6" -sb "#e6e6e6" -sf "#000000"

super + c
      emacsclient -c 

super + q
      bspc node -c

super + b
   bspc node -f west
super + n
   bspc node -f south
super + p
   bspc node -f north
super + f
   bspc node -f east

super + Tab
    bspc node -f next.local

# bspwm window resizing
super + alt + h
    bspc node -z left -25 0
super + alt + l
    bspc node -z right 25 0

# Switch to named desktop (adjust according to your names)
super + 1
    bspc desktop -f "(first)"

super + 2
    bspc desktop -f "(second)"

super + 3
    bspc desktop -f "(third)"

super + 4
    bspc desktop -f "(fourth)"

super + 5
    bspc desktop -f "(fifth)"

super + shift + 1
    bspc node -d "(first)"

super + shift + 2
    bspc node -d "(second)"

super + shift + 3
    bspc node -d "(third)"

super + shift + 4
    bspc node -d "(fourth)"

super + shift + 5
    bspc node -d "(fifth)"

super + alt + b
      bb ~/.local/bin/battery.clj -n

super + shift + space
    bspc node -t ~floating; bspc node -v 0 0; bspc node --flag center

XF86AudioRaiseVolume
  pamixer --increase 5

# Volume down
XF86AudioLowerVolume
  pamixer --decrease 5

# Mute toggle
XF86AudioMute
  pamixer --toggle-mute

super + shift + l
    $HOME/.local/bin/lock.sh
